<section class="benefit-grid container">
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="benefit-grid__items">
    {%- for block in section.blocks -%}
      <div class="benefit-grid__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Benefit grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it works" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit grid",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Supports the skin barrier", "text": "Formulated around barrier-supporting ingredients \u2014 pending final formulation copy." } },
        { "type": "benefit", "settings": { "title": "One step, not five", "text": "Built to replace multiple products, not add another one." } },
        { "type": "benefit", "settings": { "title": "Low-irritation first", "text": "Developed for routine-fatigued, sensitized skin." } }
      ]
    }
  ]
}
{% endschema %}
