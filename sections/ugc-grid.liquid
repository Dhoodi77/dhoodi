{%- comment -%}
  Populate blocks in the theme editor with real customer/creator content only.
  No placeholder posts are shipped with this section by default.
{%- endcomment -%}
<section class="ugc-grid container">
  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ugc-grid__items">
      {%- for block in section.blocks -%}
        <figure class="ugc-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.media != blank -%}
            {{ block.settings.media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', alt: block.settings.caption }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          {%- if block.settings.source_link != blank -%}
            <a href="{{ block.settings.source_link }}" class="ugc-grid__source">View original post</a>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="empty-state">Add real customer/creator posts as blocks once you have them \u2014 do not ship this section with placeholder content.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "UGC grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the community" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "UGC post",
      "settings": [
        { "type": "image_picker", "id": "media", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption / attribution" },
        { "type": "url", "id": "source_link", "label": "Link to original post" }
      ]
    }
  ],
  "presets": [{ "name": "UGC grid" }]
}
{% endschema %}
