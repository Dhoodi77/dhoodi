<section class="bundle-block container">
  <div class="bundle-block__inner">
    <div class="bundle-block__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.product != blank -%}
        {% render 'price', product: section.settings.product %}
        <a href="{{ section.settings.product.url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="bundle-block__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: section.settings.heading }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle block",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Barrier Reset Duo" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the duo" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Bundle block" }]
}
{% endschema %}
