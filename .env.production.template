# TradeOS Production Environment Configuration
# Copy to .env and fill in all values marked with [REQUIRED]
# DO NOT commit .env to git

# ============================================================
# MODE & AUTHENTICATION [REQUIRED]
# ============================================================
# Set to 'paper' for paper trading, 'live' for real trades (DO NOT enable without understanding risks)
TRADEOS_MODE=paper

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TRADEOS_DASHBOARD_TOKEN=[REQUIRED]

# ============================================================
# DATABASE [REQUIRED]
# ============================================================
# PostgreSQL connection string (automatically managed by Docker)
# Format: postgresql://username:password@host:port/database
DB_PASSWORD=[REQUIRED]

# ============================================================
# LLM CONFIGURATION (Optional but recommended)
# ============================================================
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=[OPTIONAL - agents use heuristics if not set]

# Model selection (defaults shown)
TRADEOS_MODEL_FAST=claude-haiku-4-5
TRADEOS_MODEL_REASONING=claude-opus-5
TRADEOS_MODEL_DECISION=claude-opus-5

# ============================================================
# RISK POLICY [REQUIRED - no trading without these]
# ============================================================
# Hard limit: no position can exceed $20 (product policy)
TRADEOS_RISK_MAX_INITIAL_POSITION_USD=20

# Maximum total position size after averaging
TRADEOS_RISK_MAX_POSITION_USD=20

# Maximum loss in a single day (stop loss across all positions)
TRADEOS_RISK_MAX_DAILY_LOSS_USD=40

# Maximum total exposure across all open positions
TRADEOS_RISK_MAX_PORTFOLIO_EXPOSURE_USD=100

# Maximum allowed slippage on a trade (percent)
TRADEOS_RISK_MAX_SLIPPAGE_PCT=3.0

# Maximum gas/priority fees per transaction (USD)
TRADEOS_RISK_MAX_GAS_USD=2.0

# Maximum number of simultaneous open positions
TRADEOS_RISK_MAX_OPEN_POSITIONS=5

# Maximum portfolio drawdown before emergency exit (percent)
TRADEOS_RISK_MAX_DRAWDOWN_PCT=25

# Emergency stop-loss level (total portfolio USD)
TRADEOS_RISK_EMERGENCY_STOP_LOSS_USD=80

# ============================================================
# TRADING UNIVERSE
# ============================================================
# Comma-separated list of allowed chains
TRADEOS_ALLOWED_CHAINS=solana,ethereum,base,bsc,arbitrum,polygon

# Minimum token liquidity to consider (USD)
TRADEOS_MIN_LIQUIDITY_USD=25000

# Minimum 24h trading volume (USD)
TRADEOS_MIN_VOLUME_24H_USD=50000

# Minimum token age (hours) - prevent rug pulls
TRADEOS_MIN_TOKEN_AGE_HOURS=1

# ============================================================
# PAPER TRADING CONFIGURATION
# ============================================================
TRADEOS_PAPER_STARTING_BALANCE_USD=500
TRADEOS_PAPER_SIMULATED_SLIPPAGE_PCT=1.0

# ============================================================
# EXIT RULES (Momentum Strategy v1)
# ============================================================
TRADEOS_EXIT_STOP_LOSS_PCT=15
TRADEOS_EXIT_TAKE_PROFIT_PCT=30
TRADEOS_EXIT_MAX_HOLD_HOURS=24

# ============================================================
# SCHEDULER INTERVALS (seconds)
# ============================================================
TRADEOS_DISCOVERY_INTERVAL_S=120
TRADEOS_MONITOR_INTERVAL_S=30

# ============================================================
# BLOCKCHAIN INDEXERS (Optional but recommended)
# ============================================================
# Helius API key for Solana on-chain analysis
# Get free key at: https://dev.helius.xyz
TRADEOS_HELIUS_API_KEY=[OPTIONAL]

# Etherscan API key for EVM on-chain analysis (ethereum, base, bsc, arbitrum, polygon)
# Get free key at: https://etherscan.io/apis
TRADEOS_ETHERSCAN_API_KEY=[OPTIONAL]

# ============================================================
# SMART MONEY DETECTION
# ============================================================
TRADEOS_SMARTMONEY_SCAN_INTERVAL_S=600
TRADEOS_SMARTMONEY_MAX_WALLETS_PER_SCAN=8
TRADEOS_SMARTMONEY_MIN_WALLET_TRADES=3
TRADEOS_SMARTMONEY_SCORE_THRESHOLD=65
TRADEOS_WHALE_SOL_THRESHOLD=50
TRADEOS_WHALE_USD_THRESHOLD=5000

# ============================================================
# WEBHOOKS (Optional - requires public HTTPS URL)
# ============================================================
# Your public HTTPS URL (e.g., https://app.example.com)
# Required for real-time webhook events from Helius
TRADEOS_PUBLIC_URL=[OPTIONAL]

# Generate webhook secret with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TRADEOS_HELIUS_WEBHOOK_SECRET=[OPTIONAL]

TRADEOS_WEBHOOK_MAX_ADDRESSES=100

# ============================================================
# EXTERNAL SIGNER CONFIGURATION
# ============================================================
# Token for signer authentication (must match in both services)
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SIGNER_TOKEN=[REQUIRED]

# Paths to key files (inside signer container - configure on host)
# Solana keypair: solana-cli format (id.json from ~/.config/solana/)
SIGNER_KEYPAIR_PATH=[OPTIONAL]

# EVM private key: hex format (0x-prefixed)
SIGNER_EVM_KEY_PATH=[OPTIONAL]

# Maximum value (wei) that EVM signer will approve for a single transaction
# Default: 0.1 ETH (100000000000000000 wei)
SIGNER_EVM_MAX_VALUE_WEI=100000000000000000

# Comma-separated list of EVM chain IDs the signer will accept
# 1=Ethereum, 8453=Base, 56=BSC, 42161=Arbitrum, 137=Polygon
SIGNER_EVM_CHAIN_IDS=1,8453,56,42161,137

# Maximum signing requests per hour
SIGNER_MAX_PER_HOUR=30

# ============================================================
# LIVE TRADING [DANGEROUS - DO NOT ENABLE WITHOUT FULL UNDERSTANDING]
# ============================================================
# MUST be exactly: I_UNDERSTAND_THE_RISKS
# Only set this after testing paper trading thoroughly
TRADEOS_LIVE_TRADING_CONFIRM=

# Price impact threshold (percent) - maximum acceptable price difference
TRADEOS_LIVE_MAX_PRICE_IMPACT_PCT=2.0

# Maximum priority fee for Solana transactions (lamports)
TRADEOS_LIVE_PRIORITY_FEE_LAMPORTS_MAX=1000000

# Timeout for awaiting transaction confirmation (seconds)
TRADEOS_LIVE_CONFIRM_TIMEOUT_S=60

# 0x Swap API key (for EVM live trading)
# Get free key at: https://0x.org
TRADEOS_ZEROX_API_KEY=[OPTIONAL]

# Gas limit multiplier for EVM transactions (to ensure execution)
TRADEOS_LIVE_GAS_LIMIT_MULTIPLIER=1.2

# ============================================================
# RPC ENDPOINTS [REQUIRED only if using live trading]
# ============================================================
# Solana RPC (use Helius endpoint or your own)
TRADEOS_RPC_SOLANA=

# Ethereum RPC (Alchemy, Infura, or own)
TRADEOS_RPC_ETHEREUM=

# Base RPC
TRADEOS_RPC_BASE=

# BSC RPC
TRADEOS_RPC_BSC=

# Arbitrum RPC
TRADEOS_RPC_ARBITRUM=

# Polygon RPC
TRADEOS_RPC_POLYGON=

# ============================================================
# DOMAIN CONFIGURATION
# ============================================================
# Your domain name (e.g., example.com)
# For HTTPS/SSL certificate configuration
DOMAIN_NAME=[REQUIRED for HTTPS]

# Email for Let's Encrypt notifications
LE_EMAIL=[REQUIRED if using Let's Encrypt]
