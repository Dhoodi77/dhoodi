# TradeOS configuration.
# Copy to .env and fill in. The system REFUSES to trade (even paper) if the
# risk parameters are missing. LIVE mode additionally requires wallet/chain/DEX
# configuration and TRADEOS_LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISKS.

# --- Mode: development | paper | live ---
TRADEOS_MODE=development

# --- API / dashboard ---
TRADEOS_API_HOST=127.0.0.1
TRADEOS_API_PORT=8420
# Required to access the dashboard/API. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TRADEOS_DASHBOARD_TOKEN=

# --- Database ---
TRADEOS_DATABASE_PATH=./data/tradeos.db

# --- Anthropic (optional; agents fall back to deterministic heuristics without it) ---
ANTHROPIC_API_KEY=
# Model routing (role -> model id). Defaults shown.
TRADEOS_MODEL_FAST=claude-haiku-4-5
TRADEOS_MODEL_REASONING=claude-opus-5
TRADEOS_MODEL_DECISION=claude-opus-5

# --- Risk policy (ALL required before any trading is allowed) ---
# Hard cap on any newly opened position, USD. Code-level ceiling is 20.
TRADEOS_RISK_MAX_INITIAL_POSITION_USD=20
TRADEOS_RISK_MAX_POSITION_USD=20
TRADEOS_RISK_MAX_DAILY_LOSS_USD=40
TRADEOS_RISK_MAX_PORTFOLIO_EXPOSURE_USD=100
TRADEOS_RISK_MAX_SLIPPAGE_PCT=3.0
TRADEOS_RISK_MAX_GAS_USD=2.0
TRADEOS_RISK_MAX_OPEN_POSITIONS=5
TRADEOS_RISK_MAX_DRAWDOWN_PCT=25
TRADEOS_RISK_EMERGENCY_STOP_LOSS_USD=80

# --- Trading universe ---
TRADEOS_ALLOWED_CHAINS=solana,ethereum,base,bsc,arbitrum,polygon
TRADEOS_MIN_LIQUIDITY_USD=25000
TRADEOS_MIN_VOLUME_24H_USD=50000
TRADEOS_MIN_TOKEN_AGE_HOURS=1

# --- Paper trading ---
TRADEOS_PAPER_STARTING_BALANCE_USD=500
TRADEOS_PAPER_SIMULATED_SLIPPAGE_PCT=1.0

# --- Exits (momentum strategy v1) ---
TRADEOS_EXIT_STOP_LOSS_PCT=15
TRADEOS_EXIT_TAKE_PROFIT_PCT=30
TRADEOS_EXIT_MAX_HOLD_HOURS=24

# --- Scheduler intervals (seconds) ---
TRADEOS_DISCOVERY_INTERVAL_S=120
TRADEOS_MONITOR_INTERVAL_S=30

# --- Helius indexer (Solana on-chain intelligence + smart-money discovery) ---
# Get a key at https://dev.helius.xyz (free tier works). When set, the Solana
# provider upgrades to full holder distribution and the smart-money scanner
# starts analyzing wallets that trade the tokens the system watches.
TRADEOS_HELIUS_API_KEY=
TRADEOS_SMARTMONEY_SCAN_INTERVAL_S=600
TRADEOS_SMARTMONEY_MAX_WALLETS_PER_SCAN=8
TRADEOS_SMARTMONEY_MIN_WALLET_TRADES=3
TRADEOS_SMARTMONEY_SCORE_THRESHOLD=65
TRADEOS_WHALE_SOL_THRESHOLD=50

# --- Live execution (Stage 7; leave empty until then) ---
TRADEOS_LIVE_TRADING_CONFIRM=
# RPC endpoints per chain, e.g.:
# TRADEOS_RPC_SOLANA=https://...
# TRADEOS_RPC_ETHEREUM=https://...
