<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#E8DFD6">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <title>
    {{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}
  </title>

  {%- comment -%} Open Graph {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title }}">
  {%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
  {%- if page_image -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">

  {%- comment -%} Organization structured data {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
  }
  </script>

  {{ content_for_header }}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'sections.css' | asset_url }}">

  {%- comment -%}
    Fonts: two families max per the brand spec — a display serif for headings,
    a grotesk for UI/body. Swap embed_url for the licensed font files you use.
  {%- endcomment -%}
  <style>
    :root{
      --color-bg: #E8DFD6;
      --color-surface: #FFFFFF;
      --color-text: #1B1B1B;
      --color-muted: #6B6B6B;
      --color-accent: #8A6D5C;
      --color-accent-dark: #6E574A;
      --color-sage: #A9B29A;
      --radius: 4px;
      --font-display: Georgia, 'Times New Roman', serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Arial, sans-serif;
      --container: 1180px;
    }
  </style>
</head>
<body class="template-{{ template.name }}">
  <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t: default: 'Skip to content' }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
