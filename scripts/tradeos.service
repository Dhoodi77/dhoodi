# systemd unit for 24/7 supervised operation on a VPS.
# Install:
#   sudo cp scripts/tradeos.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tradeos
[Unit]
Description=TradeOS autonomous crypto trading system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradeos
WorkingDirectory=/opt/tradeos
EnvironmentFile=/opt/tradeos/.env
ExecStart=/usr/bin/python3 -m tradeos.main
Restart=always
RestartSec=5
# Hard resource bounds
MemoryMax=2G
# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tradeos/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
